# Copy this file to .env.playground (same folder) and fill it in. .env.playground is git-ignored — never commit keys.

# Supabase DEVELOPMENT database (never production): Supabase dashboard → Connect → "Session pooler" connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# AI model — any OpenAI-compatible endpoint. Mistral (EU):
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-small-latest
# Alternatives: OpenAI  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
#               Ollama (free, local; weaker at booking)  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:14b

# Optional — talk out loud (English). Without it, typed chat still works.
DEEPGRAM_API_KEY=
# EU endpoint. If your key is not enabled for the EU region, use api.deepgram.com
DEEPGRAM_BASE=api.eu.deepgram.com

# Optional — Croatian voice for the Croatian demo business.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# PLAYGROUND_PORT=4321
